menu "ESP32-64KEmulator Configuration"
    menu "Device Config"
        choice ESP32_DEVICE_SELECTED
            default WT32_SC01_H
            prompt "Select the device"
            config WT32_DEVICE_NONE
                bool "Select a supported device"
            config WT32_SC01_H
                bool "Wireless-Tag WT32-SC01 - SPI - 4MB Flash"
                help
                    This is the device with 4MB Flash on a WT32-SC01 device.
        endchoice
    endmenu
endmenu