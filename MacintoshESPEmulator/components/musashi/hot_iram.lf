# Musashi hot-path IRAM placement (ESP32 A/B switch, OFF by default).
# Enabled by set(MUSASHI_HOT_IRAM ON) in components/musashi/CMakeLists.txt.
# m68k_execute + the 128 opcode handlers that executed most often on the
# host harness (LC II + Classic, boot to Finder idle, gprof call counts):
# they cover ~94% of executed 68k instructions. x86 size of this set is
# ~17KB (handlers ~14.7KB with M68K_INLINE_RAM, m68k_execute ~2.5KB);
# expect similar on Xtensa. CLAUDE.md IRAM headroom: ~70KB. Trim the list
# from the bottom if the link reports IRAM overflow.
[mapping:musashi_hot]
archive: libmusashi.a
entries:
    m68kcpu:m68k_execute (noflash)
    m68kops:m68k_op_movea_32_di (noflash)
    m68kops:m68k_op_moveq_32 (noflash)
    m68kops:m68k_op_rts_32 (noflash)
    m68kops:m68k_op_beq_8 (noflash)
    m68kops:m68k_op_bne_8 (noflash)
    m68kops:m68k_op_move_32_pd_a (noflash)
    m68kops:m68k_op_jsr_32_pcdi (noflash)
    m68kops:m68k_op_move_32_d_di (noflash)
    m68kops:m68k_op_link_16 (noflash)
